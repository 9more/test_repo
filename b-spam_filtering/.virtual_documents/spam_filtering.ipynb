# Importing Libraries
import pandas as pd
import numpy as np
import spacy
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.svm import LinearSVC
from sklearn.naive_bayes import GaussianNB
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import GridSearchCV, train_test_split
from sklearn.metrics import f1_score, make_scorer
from sklearn.pipeline import Pipeline
import pickle


import kagglehub
# Download latest version
path = kagglehub.dataset_download("jackksoncsie/spam-email-dataset")
path=path.replace('.cache', 'Documents')


!pip install -U spacy
!python -m spacy download en_core_web_sm


df= pd.read_csv(f'{path}/emails.csv')


df.head()


df.text.str.len().sum()


nlp=spacy.load('en_core_web_sm') # Function to clean and process the data for training
def lemma(text):
    doc=nlp(''.join(text))
    tok=[token.lemma_ for token in doc if not token.is_punct and not token.is_stop]
    return ' '.join(tok)


df['text_xtract']=df.text.apply(lemma)


print(df.text_xtract.str.len().sum())
df.spam.value_counts(normalize=True)  #Checking to see how unbalanced is the dataset


Xtrain, Xtest, ytrain, ytest=train_test_split(df['text_xtract'].values,df['spam'].values,
                                              test_size=.1,
                                              random_state=42,
                                              shuffle=True)


pipe=Pipeline([('transformer',TfidfVectorizer()),
               ('model', LinearSVC())
              ]
             )
params = [
    {
        'model': [LinearSVC()],
        'model__C': np.linspace(0.5, 2, 6),
        'model__class_weight': [{0: 1, 1: v} for v in range(1, 6)]
    },
    {
        'model': [LogisticRegression(max_iter=1000)],
        'model__C': np.linspace(0.5, 2, 6),
        'model__class_weight': [{0: 1, 1: v} for v in range(1, 6)]
    }
    ]
grid= GridSearchCV(pipe,
                 param_grid=params,
                 cv=5,
                 #scoring='f1',
                 refit=True
                 )


mod= grid.fit(Xtrain, ytrain)


mod.best_estimator_



f1_score(mod.best_estimator_.predict(Xtest), ytest)


t= [r"Subject: naturally irresistible your corporate identity  lt is really hard to recollect a company : the"]

df =pd.read_csv('sentiment_analysis/Copy of File1.csv', 
                parse_dates = ['loan_signdate','customer_date_of_birth'],
               dayfirst=True,
               keep_default_na=True)
df.head(5)





df[['loan_contractapproveddate','customer_date_of_birth']] = \
df[['loan_contractapproveddate','customer_date_of_birth']].map(
    lambda x: np.nan if isinstance(x,str) and '0000' in x else x)
df.dropna(inplace=True)
df.drop_duplicates(inplace=True)
df[['loan_contractapproveddate','loan_signdate']]=\
df[['loan_contractapproveddate',
    'loan_signdate']].apply(pd.to_datetime, dayfirst=True)

df['dob']=pd.to_datetime(df['customer_date_of_birth'],dayfirst=True).dt.year
df['age']=df['year']- df['dob']
df['day_to_app'] = (
    df['loan_contractapproveddate']
    - df['loan_signdate']).dt.days
df['day_to_app'].describe()


df[['a_group', 'loan_contractapproveddate', 'customer_date_of_birth']]



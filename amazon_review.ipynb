   "source": [
    "df[['loan_contractapproveddate','customer_date_of_birth']] = \\\n",
    "df[['loan_contractapproveddate','customer_date_of_birth']].map(\n",
    "    lambda x: np.nan if isinstance(x,str) and '0000' in x else x)\n",
    "df.dropna(inplace=True)\n",
    "df.drop_duplicates(inplace=True)\n",
    "df[['loan_contractapproveddate','loan_signdate']]=\\\n",
    "df[['loan_contractapproveddate',\n",
    "    'loan_signdate']].apply(pd.to_datetime, dayfirst=True)\n",
    "df['dob']=pd.to_datetime(df['customer_date_of_birth'],dayfirst=True).dt.year\n",
    "df['age']=df['year']- df['dob']\n",
    "df['day_to_app'] = (\n",
    "    df['loan_contractapproveddate']\n",
    "    - df['loan_signdate']).dt.days\n",
    "df.loc[df['day_to_app']>=0]"
   ]
